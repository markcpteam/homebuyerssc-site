---
import { BIZ } from '../consts';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
const { title, description, type = 'page', datePublished, dateModified, breadcrumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, BIZ.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:site_name" content={BIZ.name} />
<meta name="twitter:card" content="summary_large_image" />
<Schema type={type} title={title} description={description} url={canonical} datePublished={datePublished} dateModified={dateModified} breadcrumbs={breadcrumbs} />
<link rel="sitemap" href="/sitemap-index.xml" />
<style is:global>
:root{--ink:#12203a;--mut:#5a6b85;--line:#dfe5ee;--bg:#fff;--soft:#f4f7fb;--brand:#0b5c3f;--brand2:#0e7a53;--accent:#c8892a}
*{box-sizing:border-box}
body{margin:0;font:16px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);background:var(--bg)}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
a{color:var(--brand2)}
h1,h2,h3{line-height:1.25;color:var(--ink)}
h1{font-size:2.1rem;margin:0 0 .6rem}
h2{font-size:1.4rem;margin:2rem 0 .6rem}
h3{font-size:1.1rem;margin:1.5rem 0 .4rem}
.site-head{border-bottom:1px solid var(--line);background:#fff;position:sticky;top:0;z-index:10}
.head-inner{display:flex;align-items:center;gap:1.2rem;padding-top:.8rem;padding-bottom:.8rem;flex-wrap:wrap}
.brand{font-weight:800;font-size:1.15rem;color:var(--brand);text-decoration:none}
.site-head nav{display:flex;gap:1rem;flex-wrap:wrap;margin-left:auto}
.site-head nav a{text-decoration:none;color:var(--ink);font-size:.94rem}
.site-head nav a.cta{background:var(--brand);color:#fff;padding:.45rem .9rem;border-radius:6px;font-weight:600}
.tel{font-weight:700;color:var(--brand);text-decoration:none;white-space:nowrap}
main{padding:2.2rem 0 3rem}
.lede{font-size:1.12rem;color:var(--mut)}
.prose{max-width:72ch}
.prose ul,.prose ol{padding-left:1.2rem}
.prose li{margin:.3rem 0}
.card{border:1px solid var(--line);border-radius:10px;padding:1.1rem 1.2rem;background:#fff}
.grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(260px,1fr))}
.related{background:var(--soft);border:1px solid var(--line);border-radius:10px;padding:1rem 1.2rem;margin:2.2rem 0}
.related h2{margin-top:0;font-size:1.05rem}
.related ul{margin:0;padding-left:1.1rem}
.author{border-top:1px solid var(--line);margin-top:2rem;padding-top:1rem;color:var(--mut);font-size:.95rem}
.offerbox{background:var(--brand);color:#fff;border-radius:12px;padding:1.4rem 1.5rem;margin:2rem 0}
.offerbox h2{color:#fff;margin-top:0}
.offerbox a{color:#fff;font-weight:700}
.crumbs{font-size:.85rem;color:var(--mut);margin-bottom:1rem}
.crumbs a{color:var(--mut)}
.site-foot{background:var(--soft);border-top:1px solid var(--line);margin-top:3rem;padding:2.2rem 0 1rem;font-size:.92rem}
.foot-grid{display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.site-foot h2{font-size:1rem;margin:0 0 .6rem}
.site-foot ul{list-style:none;margin:0;padding:0}
.site-foot li{margin:.25rem 0}
.site-foot ul.cols{columns:2;column-gap:1rem}
.proof{color:var(--mut)}
.foot-legal{border-top:1px solid var(--line);margin-top:1.6rem;padding-top:.9rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;color:var(--mut)}
form.offer{display:grid;gap:.7rem;max-width:520px}
form.offer label{font-weight:600;font-size:.92rem}
form.offer input,form.offer textarea{width:100%;padding:.6rem .7rem;border:1px solid var(--line);border-radius:6px;font:inherit}
form.offer button{background:var(--brand);color:#fff;border:0;padding:.7rem 1.2rem;border-radius:6px;font-weight:700;font-size:1rem;cursor:pointer}
table{border-collapse:collapse;width:100%}
td,th{border:1px solid var(--line);padding:.5rem .6rem;text-align:left}
@media(max-width:640px){h1{font-size:1.6rem}.site-head nav{width:100%;margin-left:0}}
</style>
</head>
<body>
<Nav />
<main><div class="wrap"><slot /></div></main>
<Footer />
<!-- CallRail tracking script goes here once the number pool is configured (deferred until after launch). -->
</body>
</html>
