---
import { BIZ, GROUPS } from '../consts';
import { getCollection } from 'astro:content';
const cities = (await getCollection('cities')).sort((a,b)=>a.data.city.localeCompare(b.data.city));
---
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <span class="foot-logo"><img src="/logo.png" alt="Homebuyers SC, LLC" width="225" height="137" loading="lazy" /></span>
      <p>{BIZ.legalName}<br />{BIZ.street}<br />{BIZ.city}, {BIZ.region} {BIZ.zip}</p>
      <p><a href={`tel:${BIZ.phoneRaw}`} style="font-size:1.2rem;font-weight:800;color:#fff">{BIZ.phone}</a></p>
      <div class="foot-badges">
        <img src="/bbb-accredited-a-plus.png" alt={`BBB Accredited Business, ${BIZ.bbbRating} rating`} width="176" height="44" loading="lazy" />
      </div>
      <p>Buying houses for cash across the South Carolina Lowcountry since {BIZ.founded}. Over {BIZ.transactions} purchases completed. BBB accredited with an {BIZ.bbbRating} rating since {BIZ.bbbSince}.</p>
    </div>
    <div>
      <h2>Guides by situation</h2>
      <ul>{Object.entries(GROUPS).map(([k,g]) => <li><a href={`/guides/${k}/`}>{g.label}</a></li>)}</ul>
      <h2 style="margin-top:1.3rem">Company</h2>
      <ul>
        <li><a href="/how-it-works/">How it works</a></li>
        <li><a href="/about/">Meet the team</a></li>
        <li><a href="/reviews/">Reviews &amp; ratings</a></li>
        <li><a href="/how-to-choose-a-cash-home-buyer/">How to choose a cash buyer</a></li>
        <li><a href="/frequently-asked-questions/">FAQ</a></li>
        <li><a href="/contact/">Get a cash offer</a></li>
      </ul>
    </div>
    <div>
      <h2>Cities we serve</h2>
      <ul class="cols">{cities.map(c => <li><a href={`/${c.id}/`}>{c.data.city}</a></li>)}</ul>
    </div>
  </div>
  <div class="wrap foot-legal">
    <p>&copy; {new Date().getFullYear()} {BIZ.legalName}. All rights reserved.</p>
    <p><a href="/privacy/">Privacy</a> &nbsp;&middot;&nbsp; <a href="/terms-conditions/">Terms &amp; Conditions</a></p>
  </div>
</footer>
