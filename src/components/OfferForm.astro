---
import { BIZ } from '../consts';
interface Props { uid?: string; compact?: boolean; submitLabel?: string; }
const {
  uid = Math.random().toString(36).slice(2, 8),
  compact = false,
  submitLabel = 'Request my cash offer',
} = Astro.props;
const key = BIZ.googleMapsKey || '';
---
<form class={`offer${compact ? ' offer-compact' : ''}`} name="cash-offer" method="POST"
      data-netlify="true" netlify-honeypot="company-website" action="/thank-you/">
  <input type="hidden" name="form-name" value="cash-offer" />
  <p hidden><label>Do not fill this in: <input name="company-website" /></label></p>

  <div><label for={`name-${uid}`}>Your name</label>
    <input id={`name-${uid}`} name="name" required autocomplete="name" /></div>

  <div><label for={`phone-${uid}`}>Phone</label>
    <input id={`phone-${uid}`} name="phone" type="tel" required autocomplete="tel" /></div>

  <div><label for={`email-${uid}`}>Email</label>
    <input id={`email-${uid}`} name="email" type="email" required autocomplete="email" /></div>

  <div class="addr-field">
    <label for={`address-${uid}`}>Property address</label>
    <input id={`address-${uid}`} name="address" required autocomplete="street-address"
           data-address-autocomplete data-gmaps-key={key}
           role="combobox" aria-expanded="false" aria-autocomplete="list"
           aria-controls={`addr-list-${uid}`} autocapitalize="words" spellcheck="false" />
    <ul class="addr-list" id={`addr-list-${uid}`} role="listbox" hidden></ul>
    <p class="addr-hint">Start typing and pick your address, or just type it in.</p>
  </div>

  <div><label for={`situation-${uid}`}>What is going on with the property?</label>
    <textarea id={`situation-${uid}`} name="situation" rows={compact ? 2 : 5}
              placeholder="Condition, timeline, tenants, anything we should know"></textarea></div>

  <!-- How this person arrived. Invisible to the visitor, filled in by the script
       at the bottom of this file, and sent along with the form so the notification
       email and the Netlify submission both carry the attribution. This is our own
       copy: CallRail records the same thing, but its script can be blocked by an
       ad blocker and ours cannot. -->
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_term" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="gclid" value="" />
  <input type="hidden" name="landing_page" value="" />
  <input type="hidden" name="referrer" value="" />
  <input type="hidden" name="submitted_from" value="" />
  <input type="hidden" name="callrail_person_id" value="" />
  <input type="hidden" name="callrail_session_id" value="" />

  <button type="submit">{submitLabel}</button>
  <p class="offer-alt">Prefer to talk? Call or text <a href={`tel:${BIZ.phoneRaw}`}><strong>{BIZ.phone}</strong></a>.</p>
</form>

<script>
  // ---------------------------------------------------------------
  // Fill the hidden attribution fields on every offer form.
  // Runs once per page load. Reads three sources, in order of trust:
  //   1. what this browser recorded on the first page of the visit
  //   2. CallRail's own cookies
  //   3. the current page, as a last resort
  // Every read is wrapped so a blocked cookie or a private window can
  // never stop the form from submitting.
  // ---------------------------------------------------------------
  (function fillAttribution() {
    const cookie = (name) => {
      try {
        const hit = document.cookie.split('; ').find((c) => c.startsWith(name + '='));
        return hit ? decodeURIComponent(hit.slice(name.length + 1)) : '';
      } catch (e) { return ''; }
    };
    const stored = (key) => {
      try { return sessionStorage.getItem(key) || ''; } catch (e) { return ''; }
    };

    // The first page of this visit, which is where any campaign tags live.
    const landing = stored('hb_landing') || cookie('calltrk_landing') || location.href;
    // CallRail writes the literal word "direct" when there is no referring site.
    // Match that when we fall back to our own copy, so the column always reads
    // the same way instead of sometimes being blank.
    const referrer = stored('hb_referrer') || cookie('calltrk_referrer') || document.referrer || 'direct';

    let params;
    try { params = new URL(landing).searchParams; } catch (e) { params = new URLSearchParams(); }

    const values = {
      utm_source: params.get('utm_source') || '',
      utm_medium: params.get('utm_medium') || '',
      utm_campaign: params.get('utm_campaign') || '',
      utm_term: params.get('utm_term') || '',
      utm_content: params.get('utm_content') || '',
      gclid: params.get('gclid') || '',
      landing_page: landing,
      referrer: referrer,
      submitted_from: location.href,
      callrail_person_id: cookie('calltrk_fcid'),
      callrail_session_id: cookie('calltrk_session_id'),
    };

    document.querySelectorAll('form.offer').forEach((form) => {
      Object.entries(values).forEach(([name, value]) => {
        const field = form.querySelector('input[type=hidden][name="' + name + '"]');
        if (field && !field.value) field.value = value;
      });
    });
  })();

// Address suggestions from Google Places.
// The field is an ordinary text box first and foremost: if the key is missing,
// the network fails, or nothing matches what they typed, the typed text submits as-is.
const addrInputs = document.querySelectorAll('input[data-address-autocomplete]');
if (addrInputs.length) {
  const key = addrInputs[0].dataset.gmapsKey;
  if (key) {
    let loader = null;
    const mapsReady = () => !!(window.google && window.google.maps && window.google.maps.importLibrary);
    const loadPlaces = () => {
      if (!loader) {
        loader = new Promise((resolve, reject) => {
          const waitFor = (deadline) => {
            if (mapsReady()) return resolve();
            if (Date.now() > deadline) return reject(new Error('maps not ready'));
            setTimeout(() => waitFor(deadline), 50);
          };
          if (mapsReady()) return resolve();
          const s = document.createElement('script');
          s.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(key) + '&libraries=places&loading=async&v=weekly';
          s.async = true;
          // google.maps is not always populated the instant onload fires, so poll briefly
          s.onload = () => waitFor(Date.now() + 8000);
          s.onerror = () => reject(new Error('maps script failed'));
          document.head.appendChild(s);
        });
      }
      return loader;
    };

    addrInputs.forEach((input) => {
      const list = document.getElementById(input.getAttribute('aria-controls') || '');
      if (!list) return;
      let token = null, timer = null, items = [], active = -1;

      const close = () => {
        list.hidden = true; list.innerHTML = ''; items = []; active = -1;
        input.setAttribute('aria-expanded', 'false');
      };
      const choose = (i) => { if (items[i] != null) { input.value = items[i]; token = null; close(); } };
      const paint = () => {
        list.innerHTML = '';
        items.forEach((txt, i) => {
          const li = document.createElement('li');
          li.textContent = txt;
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', String(i === active));
          if (i === active) li.classList.add('is-active');
          li.addEventListener('mousedown', (ev) => { ev.preventDefault(); choose(i); });
          list.appendChild(li);
        });
        list.hidden = items.length === 0;
        input.setAttribute('aria-expanded', String(items.length > 0));
      };

      const fetchSuggestions = async (q) => {
        try {
          await loadPlaces();
          const places = await window.google.maps.importLibrary('places');
          if (!token) token = new places.AutocompleteSessionToken();
          const res = await places.AutocompleteSuggestion.fetchAutocompleteSuggestions({
            input: q, region: 'us', language: 'en-US', sessionToken: token
          });
          items = (res.suggestions || [])
            .map((sg) => sg.placePrediction && sg.placePrediction.text && sg.placePrediction.text.toString())
            .filter(Boolean).slice(0, 5);
          active = -1;
          paint();
        } catch (e) {
          close(); // silent: the field still works as a plain text box
        }
      };

      input.addEventListener('input', () => {
        clearTimeout(timer);
        const q = input.value.trim();
        if (q.length < 3) { close(); return; }
        timer = setTimeout(() => fetchSuggestions(q), 250);
      });
      input.addEventListener('keydown', (e) => {
        if (list.hidden) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, items.length - 1); paint(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); paint(); }
        else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); choose(active); }
        else if (e.key === 'Escape') { close(); }
      });
      input.addEventListener('blur', () => setTimeout(close, 150));
    });
  }
}
</script>
