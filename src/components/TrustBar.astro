---
import { BIZ } from '../consts';
---
<div class="trust">
  <div class="wrap trust-grid">
    <div><b>{BIZ.transactions}+</b><span>cash purchases closed</span></div>
    <div><b>Since {BIZ.founded}</b><span>buying in the Lowcountry</span></div>
    <div><b>7 days</b><span>closing, if you need it</span></div>
    <div><b>$0</b><span>commissions or repairs</span></div>
    <div><img src="/bbb-accredited-a-plus.png" alt={`Better Business Bureau Accredited Business, ${BIZ.bbbRating} rating`} width="176" height="44" loading="lazy" /></div>
  </div>
</div>
