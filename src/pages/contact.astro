---
import Base from '../layouts/Base.astro';
import { BIZ } from '../consts';
import OfferForm from '../components/OfferForm.astro';
---
<Base title="Contact Homebuyers SC | Free Cash Offer in 24 Hours"
      description={`Request a no-obligation cash offer on your South Carolina house. Call ${BIZ.phone} or send us the address and we will get back to you within one business day.`}>
  <h1>Get a cash offer on your house</h1>
  <p class="lede">Tell us the address and a little about the situation. No obligation, no fee, and we will get back to you within one business day.</p>
  <p><strong>Prefer to talk? Call <a href={`tel:${BIZ.phoneRaw}`}>{BIZ.phone}</a>.</strong></p>

  <OfferForm uid="contact" />

  <h2>Where we are</h2>
  <p>{BIZ.legalName}<br />{BIZ.street}<br />{BIZ.city}, {BIZ.region} {BIZ.zip}<br /><a href={`tel:${BIZ.phoneRaw}`}>{BIZ.phone}</a></p>
</Base>
