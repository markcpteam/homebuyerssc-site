---
import Base from '../layouts/Base.astro';
import LegalNote from '../components/LegalNote.astro';
import { getCollection } from 'astro:content';
import { GROUPS, BIZ } from '../consts';
import TrustBar from '../components/TrustBar.astro';
import Steps from '../components/Steps.astro';
const all = await getCollection('guides');
const cities = (await getCollection('cities')).sort((a,b)=>a.data.city.localeCompare(b.data.city));
const reasons = [
  ['Avoid or stop foreclosure','/avoid-or-stop-foreclosure-south-carolina/'],
  ['Downsizing or retiring','/downsizing-your-home-south-carolina/'],
  ['A parent or relative passed away','/sell-inherited-house-south-carolina/'],
  ['You need cash now','/need-cash-now-south-carolina/'],
  ['An alternative to an estate sale','/alternative-to-estate-sale-south-carolina/'],
  ['Divorce or separation','/sell-house-during-divorce-south-carolina/'],
  ['Problem tenants','/sell-house-with-tenants-south-carolina/'],
];
---
<Base title="Sell My House Fast For Cash in South Carolina | Homebuyers SC"
      description={`We buy houses for cash in Charleston, Mount Pleasant, Summerville, and across SC. Close in 7 days, no repairs, no commissions. Call ${BIZ.phone}.`} bare>
  <div class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Sell your house fast for cash in South Carolina</h1>
        <p class="sub">A local, family-owned buyer. We take the house exactly as it sits, and you pick the closing date.</p>
        <ul>
          <li>No repairs, no cleaning, no showings</li>
          <li>No agent commissions and no fees</li>
          <li>Close in as few as 7 days, or later if you need time</li>
          <li>A real cash offer, usually within 24 hours</li>
        </ul>
        <div class="hero-cta">
          <a href="/contact/" class="btn btn-lg">Get my cash offer</a>
          <a class="hero-call" href={`tel:${BIZ.phoneRaw}`}>or call {BIZ.phone}</a>
        </div>
      </div>
      <div class="hero-card">
        <h2>What is the house?</h2>
        <p>Tell us the address and what is going on. No obligation, no pressure, and we will get back to you within one business day.</p>
        <a href="/contact/" class="btn btn-blue" style="display:block;text-align:center">Start here</a>
        <p style="margin:.9rem 0 0;font-size:.87rem">Prefer to talk? Call <a href={`tel:${BIZ.phoneRaw}`}><strong>{BIZ.phone}</strong></a>.</p>
      </div>
    </div>
  </div>

  <TrustBar />

  <section>
  <div class="wrap">
    <h2 style="margin-top:0">How selling to us works</h2>
    <p class="lede">Four steps. No listing, no open houses, no waiting on somebody else's mortgage approval.</p>
    <Steps />
    <p style="margin-top:1.6rem"><a href="/how-it-works/">See the full process, including what you actually net</a>.</p>
    </div>
  </section>

  <section class="tint">
  <div class="wrap">
    <h2 style="margin-top:0">Why people sell to us</h2>
    <p class="lede">Most of the homeowners we buy from are not moving up. Something happened, and the house became the problem.</p>
    <div class="grid" style="margin-top:1.3rem">
      {reasons.map(([label,href]) => (
        <article class="card"><h3><a href={href}>{label}</a></h3></article>
      ))}
    </div>
    </div>
  </section>

  <section>
  <div class="wrap">
    <h2 style="margin-top:0">Our track record, in plain numbers</h2>
    <div class="prose">
      <p>Homebuyers SC has operated in the South Carolina Lowcountry since {BIZ.founded} and has completed over {BIZ.transactions} purchases. The company is accredited by the Better Business Bureau with an {BIZ.bbbRating} rating, held since {BIZ.bbbSince}. Founder {BIZ.author.name} is a licensed South Carolina real estate agent, license number {BIZ.author.license}, with {BIZ.author.years}+ years of investing experience.</p>
      <p>We are not a national call center buying leads. We are local, we look at the house ourselves, and the person who makes the offer is the person who closes it.</p>
      <p><a href="/reviews/">Read what sellers have said</a> or <a href="/about/">meet the team</a>.</p>
    </div>
    </div>
  </section>

  <section class="tint">
  <div class="wrap">
    <h2 style="margin-top:0">What situation are you in?</h2>
    <p class="lede">{all.length} plain-English guides, grouped by what is actually standing in the way.</p>
    <div class="grid" style="margin-top:1.3rem">
      {Object.entries(GROUPS).map(([k,g]) => {
        const n = all.filter(p=>p.data.group===k).length;
        return (
          <article class="card">
            <h3><a href={`/guides/${k}/`}>{g.label}</a></h3>
            <p>{g.blurb}</p>
            <p class="count">{n} guides</p>
          </article>
        );
      })}
    </div>
    </div>
  </section>

  <section>
  <div class="wrap">
    <h2 style="margin-top:0">Where we buy</h2>
    <p class="lede">Charleston, Berkeley, and Dorchester counties, plus the surrounding towns.</p>
    <ul class="prose" style="columns:3;list-style:none;padding:0;margin-top:1rem">
      {cities.map(c => <li style="margin:.3rem 0"><a href={`/${c.id}/`}>{c.data.city}</a></li>)}
    </ul>
    </div>
  </section>
  <LegalNote />
</Base>
